[ext_resource type="Shader" path="res://resources/cover_glow.gdshader" id="7_coverglow"]

; 卡片外观（脚本没跑之前的兜底 / 编辑器预览用）：四个圆角的白卡。
;
; ⚠️ 真正的样式由 scripts/mode_cover_style.gd 在运行时套上（统一入口）：
;      选中 / 中间高亮放大的那张 → 带一圈绿色光晕
;      其它卡片                   → 只有圆角，没有光晕
;
; 圆角本身要靠节点上的 clip_children 用它当遮罩，把封面图裁成四角圆角
;（所有卡片都是这个效果）；底色必须不透明，否则光晕会从卡片内部透出来。
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_cover"]
bg_color = Color(1, 1, 1, 1)
corner_radius_top_left = 40
corner_radius_top_right = 40
corner_radius_bottom_right = 40
corner_radius_bottom_left = 40
corner_detail = 20

; 光晕节点的材质（shader 参数由 mode_cover_style.gd 写入）
[sub_resource type="ShaderMaterial" id="ShaderMaterial_coverglow"]
shader = ExtResource("7_coverglow")

[node name="ModeSelect" type="Control" unique_id=1451242520]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_pcda8")

[node name="CoverFlow" type="Control" parent="." unique_id=410167652]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

; 光晕：由 mode_select.gd 每帧对齐到「当前选中那张卡片」并改大小。
; 位置/尺寸是脚本算的，这里不用管；mouse_filter=2 保证不挡触摸。
[node name="CoverGlow" type="ColorRect" parent="CoverFlow"]
z_index = 3
material = SubResource("ShaderMaterial_coverglow")
offset_right = 560.0
offset_bottom = 720.0
mouse_filter = 2
color = Color(1, 1, 1, 1)

