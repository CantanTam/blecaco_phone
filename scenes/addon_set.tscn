[gd_scene format=3 uid="uid://qrfd0mqte51"]

[ext_resource type="Script" uid="uid://bn6qx2tphjk5q" path="res://scripts/addon_set.gd" id="1_xx2wr"]

[sub_resource type="SystemFont" id="SystemFont_1n66d"]
font_names = PackedStringArray("Sans-Serif")

[sub_resource type="SystemFont" id="SystemFont_ytxg7"]

; SpeedInput（MoveSpeedRow/SpeedInput，类型是 SpinBox）的文字框圆角。
; SpinBox 内部是一个 LineEdit，它的外观来自 LineEdit 的 stylebox，
; 所以这里覆盖 LineEdit/styles/* —— 数值照抄 Godot 默认主题，
; 只把 corner_radius 从 3 改成 30。
; ⚠️ 想改圆角大小，改下面三个 StyleBoxFlat 里的
;    corner_radius_top_left / top_right / bottom_right / bottom_left 四个值即可。
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_speed_normal"]
content_margin_left = 4.0
content_margin_top = 4.0
content_margin_right = 4.0
content_margin_bottom = 4.0
bg_color = Color(0.1, 0.1, 0.1, 0.6)
border_width_bottom = 2
border_color = Color(0, 0, 0, 0.6)
corner_radius_top_left = 30
corner_radius_top_right = 30
corner_radius_bottom_right = 30
corner_radius_bottom_left = 30
corner_detail = 20

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_speed_focus"]
content_margin_left = 4.0
content_margin_top = 4.0
content_margin_right = 4.0
content_margin_bottom = 4.0
draw_center = false
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.8, 0.8, 0.8, 1)
corner_radius_top_left = 30
corner_radius_top_right = 30
corner_radius_bottom_right = 30
corner_radius_bottom_left = 30
corner_detail = 20

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_speed_read_only"]
content_margin_left = 4.0
content_margin_top = 4.0
content_margin_right = 4.0
content_margin_bottom = 4.0
bg_color = Color(0.1, 0.1, 0.1, 0.3)
border_width_bottom = 2
border_color = Color(0, 0, 0, 0.3)
corner_radius_top_left = 30
corner_radius_top_right = 30
corner_radius_bottom_right = 30
corner_radius_bottom_left = 30
corner_detail = 20

[sub_resource type="Theme" id="Theme_xx2wr"]
default_font = SubResource("SystemFont_ytxg7")
default_font_size = 50
LineEdit/styles/normal = SubResource("StyleBoxFlat_speed_normal")
LineEdit/styles/focus = SubResource("StyleBoxFlat_speed_focus")
LineEdit/styles/read_only = SubResource("StyleBoxFlat_speed_read_only")

; 每行的背景 ItemBg。数值只是「脚本没跑之前的默认外观」——
; 真正的样式由 scripts/addon_set.gd 顶部的统一样式变量在 _ready() 里写进来。
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_itembg"]
content_margin_left = 10.0
content_margin_top = 10.0
content_margin_right = 10.0
content_margin_bottom = 10.0
bg_color = Color(1, 1, 1, 0.5)
corner_radius_top_left = 30
corner_radius_top_right = 30
corner_radius_bottom_right = 30
corner_radius_bottom_left = 30
corner_detail = 20

; 滑条样式。默认值同样是「脚本没跑之前的兜底」，
; 真正的值由 scripts/addon_set.gd 的统一样式变量写入。
; ⚠️ 滑条本身**不设圆角**：圆角是外层 ValueBox（clip_children）裁出来的。
; ⚠️ slider 的 content_margin_top/bottom 决定高度：
;    一个 StyleBoxFlat 的最小高度 = content_margin_top + content_margin_bottom，
;    所以 80 + 80 让它正好撑满数值框（行高 180 - 上下各 10 的 ValuePadding = 160）。
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_slider"]
content_margin_top = 80.0
content_margin_bottom = 80.0
draw_center = false

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_slider_fill"]
content_margin_top = 80.0
content_margin_bottom = 80.0
bg_color = Color(0, 1, 0, 1)

; 滑条行的数值框：既是底色，也是裁切里面滑条的遮罩（节点上 clip_children = 2）
[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_valuebox"]
bg_color = Color(0.1, 0.1, 0.1, 0.6)
corner_radius_top_left = 30
corner_radius_top_right = 30
corner_radius_bottom_right = 30
corner_radius_bottom_left = 30
corner_detail = 20

